RewriteEngine On

# www -> без www
RewriteCond %{HTTP_HOST} ^www\.dzmotortech\.ru$ [NC]
RewriteRule ^(.*)$ https://dzmotortech.ru/$1 [L,R=301]

# Файлы платформы 51microshop переехали: картинки и PDF — в /media/,
# стили, скрипты и темы — в /assets/. Старые адреса картинок помнят поисковики
# и мессенджеры, поэтому ведём их на новое место.
RewriteRule ^images\.51microshop\.com/18628/(.*)$ /media/ru/$1 [R=301,L]
RewriteRule ^images\.51microshop\.com/18187/(.*)$ /media/en/$1 [R=301,L]
RewriteRule ^images\.51microshop\.com/0/(.*)$ /media/$1 [R=301,L]
RewriteRule ^asssets\.51microshop\.com/18628/20250728092424858/assets/(.*)$ /assets/theme-ru/$1 [R=301,L]
RewriteRule ^asssets\.51microshop\.com/18187/20250430102152152/assets/(.*)$ /assets/theme-en/$1 [R=301,L]
RewriteRule ^asssets\.51microshop\.com/npm/(.*)$ /assets/vendor/$1 [R=301,L]
RewriteRule ^asssets\.51microshop\.com/assets/(.*)$ /assets/$1 [R=301,L]

# Старые адреса блога -> новые (301).
# Скрипт вызывается только если файла и папки с таким именем нет, поэтому
# на обычные страницы правило не влияет. Кириллицу в адресах разбирает PHP:
# в правилах .htaccess она ломается на повторном кодировании.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /redirects.php [L]

# /path/index.html -> /path/   (чтобы одна страница не считалась двумя)
# Условие смотрит на исходный запрос браузера: сервер внутри себя всё равно
# подставляет index.html как индексный файл, и без этой проверки правило
# зациклится.
# Подставляем $1 из самого правила (там адрес уже раскодирован), а не %1 из
# условия: в %1 кириллица приходит в виде %D0%9D…, и Apache кодировал знак
# процента ещё раз — адрес превращался в %25D0%259D… и отдавал 404.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
